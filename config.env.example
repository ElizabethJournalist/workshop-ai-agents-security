# ============================================================
# Workshop AI Agents Security — variáveis persistidas entre labs
# ============================================================
# Cada lab escreve suas saídas aqui. Helpers em shared/utils/config.py
# fazem load() e save() automaticamente — você não precisa editar à mão.
# Copie este arquivo para `config.env` antes de começar.

# ─── Setor (default: utility) ────────────────────────────────
# Determina qual subdiretório de shared/<asset>/ é usado.
SECTOR=utility

# ─── Região AWS ──────────────────────────────────────────────
AWS_REGION=us-east-1

# ─── Lab 01 — AgentCore Identity ─────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_ARN=
COGNITO_DOMAIN=
COGNITO_DISCOVERY_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_RESOURCE_SERVER_ID=

# ─── Lab 02 — AgentCore Gateway ──────────────────────────────
GATEWAY_ID=
GATEWAY_ARN=
GATEWAY_URL=
GATEWAY_ROLE_ARN=
LAMBDA_GRID_ARN=
LAMBDA_MAINTENANCE_ARN=
LAMBDA_CONTRACT_ARN=
LAMBDA_BILLING_ARN=
LAMBDA_REGULATORY_ARN=

# ─── Lab 03 — AgentCore Policy (Cedar) ───────────────────────
POLICY_STORE_ID=
POLICY_MODE=ENFORCE

# ─── Lab 04 — AgentCore Memory ───────────────────────────────
MEMORY_ID=
MEMORY_ARN=

# ─── Lab 05 — AgentCore Runtime ──────────────────────────────
RUNTIME_SMART_AGENT_ARN=
RUNTIME_GRID_AGENT_ARN=
RUNTIME_MAINTENANCE_AGENT_ARN=
RUNTIME_CONTRACT_AGENT_ARN=
RUNTIME_BILLING_AGENT_ARN=
RUNTIME_REGULATORY_AGENT_ARN=
RUNTIME_ROLE_ARN=

# ─── Lab 06 — Bedrock Guardrails ─────────────────────────────
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ─── Lab 07 — Agent Registry ─────────────────────────────────
AGENTCORE_REGISTRY_ID=

# ─── Lab 08 — Observability ──────────────────────────────────
CLOUDTRAIL_NAME=
CLOUDTRAIL_BUCKET=
SNS_ALARM_TOPIC_ARN=

# ─── Lab 09 — End-to-end UI ──────────────────────────────────
PORTAL_HOST=127.0.0.1
PORTAL_PORT=5000
